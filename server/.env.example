# PostgreSQL connection string. On Render, use the "Internal Database URL"
# from your Render Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/recruitment_crm"

# Generate a long random value, e.g.: openssl rand -base64 48
# NEVER reuse this across environments and never commit the real value.
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of origins allowed to call this API (your deployed
# frontend URL(s), and http://localhost:5173 for local dev).
CORS_ORIGIN="http://localhost:5173"

PORT=4000

# Used only by prisma/seed.js when you run `npm run seed`.
SEED_ADMIN_PASSWORD="ChangeMe123!"
